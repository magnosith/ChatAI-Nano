{
    "manifest_version": 3,
    "name": "Chat AI Nano",
    "version": "1.0.0",
    "description": "Chat com o Gemini Nano rodando localmente no Chrome, com ajuste de temperature e top K.",
    "minimum_chrome_version": "138",
    "action": {
        "default_title": "Abrir Chat AI Nano",
        "default_icon": {
            "16": "assets/icons/icon-16.png",
            "32": "assets/icons/icon-32.png"
        }
    },
    "background": {
        "service_worker": "background.js"
    },
    "icons": {
        "16": "assets/icons/icon-16.png",
        "32": "assets/icons/icon-32.png",
        "48": "assets/icons/icon-48.png",
        "128": "assets/icons/icon-128.png"
    }
}
